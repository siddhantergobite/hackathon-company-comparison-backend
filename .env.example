# Copy to .env and fill in your keys (never commit .env)

AZURE_OPENAI_ENDPOINT=https://YOUR.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# Optional — Google SERP for AEO competitor checks (250 free searches/month)
# Leave empty to use free DuckDuckGo. Only enable use_serpapi=true in API when needed.
SERPAPI_KEY=
