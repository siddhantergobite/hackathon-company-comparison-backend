# Copy to .env and fill in your keys (never commit .env)

# Azure OpenAI — PRIMARY LLM for brochure + company research (production)
AZURE_OPENAI_ENDPOINT=https://abhishekazureopenaitest.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5-mini

# Optional text fallback (Azure is primary)
GEMINI_API_KEY=

# Groq — OPTIONAL only (disabled by default; hits daily token caps)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RESEARCH_USE_GROQ=0

# Research depth — default is the fast authentic path (~30–70s)
# Set RESEARCH_DEEP=1 only for the old multi-minute extra web sweep
RESEARCH_DEEP=0
RESEARCH_SKIP_JUDGE=1
RESEARCH_SKIP_HIRING_SEARCH=1

# CIN / MCA lookup fully disabled — public website + web sources only
ENABLE_CIN_LOOKUP=0

# Optional — Google SERP for AEO competitor checks (250 free searches/month)
SERPAPI_KEY=

# ── Event Hub (global event aggregator) ─────────────────────────────────────
# MongoDB holds the events. The URI must come from here (never hardcoded).
EVENT_MONGO_URI=mongodb://localhost:27017
EVENT_MONGO_DB=event_data

# Protects /api/admin/* (Event Admin page). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the admin API.
EVENT_ADMIN_API_KEY=

# Minutes between automatic upcoming/ongoing/completed status refreshes.
EVENT_STATUS_REFRESH_MINUTES=15
# Publish ingested events automatically (false = hold all for manual approval).
EVENT_INGEST_AUTO_APPROVE=true
# Use the Azure OpenAI client above to classify events (rule-based fallback if it fails).
EVENT_AI_ENABLED=false

# Ingestion sources (all optional; collectors stay disabled until configured).
EVENT_INGEST_USER_AGENT=CasefileEventHub/1.0 (+contact: you@example.com)
EVENT_EVENTBRITE_TOKEN=
EVENT_EVENTBRITE_ORGANIZATION_IDS=
EVENT_MEETUP_ACCESS_TOKEN=
EVENT_MEETUP_GROUP_URLNAMES=
# developers.events: open list of developer conferences. Data is CC BY-NC (NON-COMMERCIAL use,
# attribution required). Set true only if your use is non-commercial.
EVENT_DEVELOPERS_EVENTS_ENABLED=false
# Public iCal/JSON feeds: copy backend/events/collectors/sources.example.json to sources.json
EVENT_FEED_SOURCES_FILE=backend/events/collectors/sources.json

# ── News Intelligence (AI news aggregator) ──────────────────────────────────
# Stored in MongoDB (collection "news"). Falls back to EVENT_MONGO_URI / MONGODB_URI when unset.
NEWS_MONGO_URI=mongodb://localhost:27017
NEWS_MONGO_DB=news_data

# Protects /api/admin/news/* (News Admin page). Falls back to EVENT_ADMIN_API_KEY when empty.
NEWS_ADMIN_API_KEY=

# Reuters / AP have no public RSS. Add a NewsAPI.org key to enable the (disabled by default)
# "Reuters & AP (via NewsAPI)" source. Optional.
NEWS_API_KEY=

# Background ingestion worker (runs inside the API process; safe with several workers via a Mongo lease).
NEWS_WORKER_ENABLED=true
# How often the worker wakes to look for due sources (each source also has its own poll minutes).
NEWS_POLL_INTERVAL_SECONDS=300
NEWS_DEFAULT_POLL_MINUTES=15
NEWS_MAX_ITEMS_PER_FETCH=60
NEWS_MAX_ARTICLE_AGE_DAYS=7
NEWS_RETENTION_DAYS=45
NEWS_USER_AGENT=CasefileNewsHub/1.0 (+contact: you@example.com)

# AI summaries / key points reuse the Azure OpenAI client configured above.
# Only headline + publisher teaser are sent; facts not in that text are rejected.
NEWS_AI_ENABLED=true
# Articles enriched per worker cycle (bounds LLM cost). The rest use extractive summaries until their turn.
NEWS_AI_MAX_PER_CYCLE=30
NEWS_AI_CONCURRENCY=3

# Story clustering window and API cache lifetimes (seconds).
NEWS_CLUSTER_WINDOW_HOURS=72
NEWS_CACHE_TTL_SHORT=30
NEWS_CACHE_TTL_LONG=300
